# --- Supabase（データベース） ---
# Supabaseのプロジェクト設定 > API から取得します
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- 管理者ログイン ---
# 自分で決めた管理者用のメールアドレスとパスワード
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=please-change-this-password
# ログインセッションの署名に使うランダムな文字列（32文字以上を推奨）
# 例: ターミナルで `openssl rand -hex 32` を実行すると作れます
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string

# --- メール配信サービス（最初はResend） ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Resendで認証済みの送信元アドレス
MAIL_FROM=Your Newsletter <you@yourdomain.com>

# --- 配信停止リンクなどに使う、あなたのアプリの公開URL ---
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Cron（定期実行）を保護するための合言葉 ---
CRON_SECRET=please-change-this-too
