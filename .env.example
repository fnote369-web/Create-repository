# Copy this file to .env (or .env.production for production builds only)
# and fill in the values once your Google Apps Script backend is deployed.
# See gas-backend/README.md for the full setup walkthrough.
#
# Leave VITE_API_BASE_URL unset to run in local demo mode (no Google
# account needed) — data is kept in this browser's localStorage only.

# VITE_API_BASE_URL=https://script.google.com/macros/s/xxxxxxxx/exec

# Optional: override the local-mode admin password (default: future-letter-admin)
# VITE_LOCAL_ADMIN_PASSWORD=change-me
